# Copia este archivo como backend/.env (scripts/instalar.ps1 lo hace y genera las claves).
# NUNCA subas backend/.env al repositorio. No pongas secretos en el frontend ni en variables VITE_.

# Clave para scripts/herramientas que llamen a la API del backend (cabecera X-API-Key)
BACKEND_API_KEY=
# Contraseña de operador para entrar a la interfaz (se cambia por una cookie de sesión httpOnly)
ADMIN_PASSWORD=
# Clave privada entre el backend y el gateway de Ollama
LLM_GATEWAY_KEY=

LLM_GATEWAY_URL=http://127.0.0.1:8001
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=qwen2.5:3b
MEXC_URL=https://api.mexc.com
POLL_SEGUNDOS=60
# Avisos por WhatsApp de oportunidades de compra (ver README, sección "Avisos por WhatsApp").
# Proveedor: greenapi (recomendado; vinculas tu WhatsApp con un QR) o callmebot.
WHATSAPP_PROVEEDOR=greenapi
# GREEN-API (plan Developer gratis): copia los tres datos de tu instancia en console.green-api.com
GREENAPI_URL=
GREENAPI_ID_INSTANCE=
GREENAPI_TOKEN=
# Opcional con GREEN-API (vacío = te escribe a tu propio número). Obligatorio con CallMeBot. Ej. +5215512345678
WHATSAPP_TELEFONO=
# Solo CallMeBot
WHATSAPP_APIKEY=
# Solo Paper. Poner TRADING_REAL=1 hace que el backend se niegue a arrancar.
TRADING_REAL=0
